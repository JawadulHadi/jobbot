# syntax=docker/dockerfile:1
# Auto-generated by agentic-cli — do not edit directly
# Regenerate with: agentengine dev up

ARG RUNNER_BASE_REPOSITORY=ghcr.io/mongodb/agent-engine-client-libraries/runner-base
ARG RUNNER_BASE_TAG=0.1.125
FROM ${RUNNER_BASE_REPOSITORY}:${RUNNER_BASE_TAG}



ENV UV_EXCLUDE_NEWER="7 days"

# Compatibility requirement for published runner-base images built before the
# framework adapter declared the detector directly.
RUN set -e; \
    whl_files=$(ls /opt/agent-engine-runner-shared/dist/*.whl 2>/dev/null) || { \
        echo "ERROR: no .whl files found in /opt/agent-engine-runner-shared/dist/ — rebuild runner-base" >&2; \
        exit 1; \
    }; \
    uv pip install --system \
        "opentelemetry-resourcedetector-gcp>=1.12.0a0,<2,!=1.13.0" \
        $whl_files
RUN uv pip install --system ruff pyright pytest watchfiles

WORKDIR /app

COPY ./.agentengine/entrypoint.py /agentic/entrypoint.py
COPY ./.agentengine/dev-entrypoint.py /agentic/dev-entrypoint.py

RUN chmod +x /agentic/dev-entrypoint.py

CMD ["/agentic/dev-entrypoint.py"]
