# Auto-generated by agentic-cli — do not edit directly
# Regenerate with: agentengine dev up

# Required agentic-cli exclusions and generated-file exceptions.
# Secrets and local configuration — never send to the Docker daemon.
**/.env
**/*.env
**/.env.*

# Local source-control, editor, and dependency artifacts.
**/.git/
**/.venv/
**/.venv-*/
**/venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.pyright/
**/node_modules/
**/*.log
**/.DS_Store
**/.agents/
**/.devcontainer/

# Generated local runtime state. Keep the entrypoints copied by the generated Dockerfiles.
# The legacy .agentic directory stays excluded: it can still hold credentials
# when both state roots exist.
**/.agentengine/
!**/.agentengine/entrypoint.py
!**/.agentengine/dev-entrypoint.py
!**/.agentengine/dev-entrypoint.python-lite.py
!**/.agentengine/entrypoint.mjs
!**/.agentengine/dev-entrypoint.mjs
**/.agentic/
