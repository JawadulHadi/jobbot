# Jobbot environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# See docs/ENV_AND_SECRETS.md for GitHub secrets/variables sync and deployment guidance.

# Required: streaming endpoint for your Atlas Agent Engine workspace.
# Deployed: https://agentengine.mongodb.com/api/v1/projects/<project id>/workspaces/<workspace id>/invokeStream
# Local dev: http://localhost:<playground-port>/invoke/stream from `agentengine dev up`
#   (use the playground UI port; review queue/history are not served on the orchestration engine port)
MONGODB_AGENTIC_API_URL=

# Required for deployed endpoints (server-side only): project service account credentials.
# Create with AGENT_DEVELOPER role. Exchanged server-side for short-lived tokens.
MONGODB_AGENTIC_CLIENT_ID=
MONGODB_AGENTIC_CLIENT_SECRET=

# Optional interim gate: HTTP Basic Auth (set both to enable). Not full end-user authz.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# Optional: only if your agent/runtime requires it (e.g. local agent dev). Not used by this Next.js app directly.
OPENAI_API_KEY=
